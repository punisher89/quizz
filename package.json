{
  "name": "quizshow-live-2-test",
  "version": "2.1.0-test",
  "private": true,
  "description": "Тестовая ПК-ветка независимой викторины в эстетике телеигры с 2v2 и семейными вопросами",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "build:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "game.quizshow.live2test",
    "productName": "Квиз LIVE 2 Тест",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "styles-live2.css"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}